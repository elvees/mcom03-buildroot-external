BR2_LINUX_KERNEL_INTREE_DTS_NAME="elvees/mcom03r-* elvees/overlays/*"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${BR2_EXTERNAL_MCOM03_PATH}/board/elvees/linux-research-freq.config"
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
BR2_PACKAGE_ELVEES_GLBENCH=y
BR2_PACKAGE_MCOM03_ASSETS=y
BR2_PACKAGE_MCOM03_ASSETS_LISTING="$(call qstrip,$(BR2_EXTERNAL_MCOM03_PATH))/board/elvees/research-freq-assets.txt"
BR2_PACKAGE_MCOM03_ROGUE_MODULES_DEVFREQ_PARENT=y
BR2_PACKAGE_MCOM03_VPU_MODULES_DEVFREQ_PARENT=y
